{
  "name": "gamesmith",
  "version": "0.4.0",
  "description": "Build web games with local AI, save to GitHub, deploy to the web",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "vendor": "node scripts/vendor.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "test:agent": "node scripts/test-agent.mjs",
    "test:github": "node scripts/test-github.mjs",
    "test:assets": "node scripts/test-assets.mjs",
    "test": "node scripts/test-agent.mjs && node scripts/test-assets.mjs && node scripts/test-github.mjs && node scripts/test-secrets.mjs && node scripts/test-import.mjs",
    "test:secrets": "node scripts/test-secrets.mjs",
    "test:import": "node scripts/test-import.mjs"
  },
  "author": "Jason Thistle",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.44.5",
    "ws": "^8.22.0"
  },
  "productName": "Gamesmith",
  "build": {
    "appId": "com.guinnessstache.gamesmith",
    "productName": "Gamesmith",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
